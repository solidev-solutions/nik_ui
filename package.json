{
  "name": "@nichtimkopf/ui",
  "version": "0.0.0-development",
  "description": "The theme and components of NichtImKopf, built on Nuxt UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidev-solutions/nik_ui.git"
  },
  "type": "module",
  "exports": {
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "prepack": "npm run build",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run && publint --strict && vue-tsc --noEmit -p test/fixtures/app"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.12.0"
  },
  "devDependencies": {
    "@nuxt/ui": "^4.12.0",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-vue": "~10.12.1",
    "prettier": "3.10.1",
    "publint": "^0.3.25",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "unbuild": "^3.6.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "unbuild": {
      "typescript": "$typescript"
    }
  }
}
